# Copiar este archivo como .env y completar lo que se tenga.
# Todo es opcional: sin claves el programa funciona igual (ver README).

# Clave gratis de https://openweathermap.org/api
# Sin clave se usa un pronostico guardado en data/fixtures
OPENWEATHER_API_KEY=tu_clave_aca

# Pronostico guardado que se usa cuando no hay clave:
#   forecast_tormenta.json  dias de tormenta, para ver alertas y correos
#   forecast_caba.json      dias normales de septiembre
PRONOSTICO_FIXTURE=forecast_tormenta.json

# Correo (N24). Con Gmail hace falta una contrasena de aplicacion (ver README).
# Sin estos datos los correos se guardan como archivos .eml en data/processed/correos
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contrasena_de_aplicacion
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Guardia municipal: recibe el reporte diario. Varios correos separados por coma.
EMAIL_GUARDIA=guardia@ejemplo.com
